    "may": ["validate local engineering configuration", "execute independent physics checks", "emit deterministic receipts"],
    "must_not": ["self-promote QPS contract truth", "promote bidder compliance", "override cryoplant child disposition"]
  },
  "federation_targets": ["GBOGEB/pipeline-automation-hub", "GBOGEB/CODEX", "GBOGEB/ABACUS", "GBOGEB/cryoplant-project"],
  "status": "PC1_CONTROL_PLANE"
}
