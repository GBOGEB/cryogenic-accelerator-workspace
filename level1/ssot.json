{
  "schema": "gbogeb-level1-ssot/v1",
  "repo": "GBOGEB/cryogenic-accelerator-workspace",
  "role": "BRIDGE_RTM_PHYSICS_WORKER",
  "default_branch": "main",
  "existing_runtime_refs": ["config/engineering_data.yaml", "src/physics_validator.py", "workspace_build.py"],
  "inputs": ["engineering configuration", "RTM/bridge inputs", "physics validation requests"],
  "outputs": ["physics validation results", "regenerated workspace artifacts", "exact-SHA/source/output receipts"],
